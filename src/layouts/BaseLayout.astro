---
import { SOCIALS, SITE } from "../config";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{SITE.title} | {SITE.description}</title>
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    body {
      background-color: #000;
      color: #eee;
    }
    a {
      color: #ccc;
      text-decoration: none;
      transition: color 0.2s;
    }
    a:hover {
      color: white;
    }
    .sidebar {
      background-color: #111;
      border-right: 1px solid #222;
      overflow-y: auto;
    }
    .card {
      background-color: #111;
      border: 1px solid #222;
    }
    .btn-github {
      background-color: #222;
      color: #eee;
    }
    .btn-github:hover {
      background-color: #333;
    }
    .btn-demo {
      background-color: #eee;
      color: #000;
    }
    .btn-demo:hover {
      background-color: #fff;
    }
    .social-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #aaa;
    }
    .social-link:hover {
      color: white;
    }
    .phone-item {
      font-size: 0.8rem;
      color: #aaa;
      margin-top: 0.25rem;
    }
  </style>
</head>
<body class="flex min-h-screen">
  <aside class="sidebar w-64 fixed top-0 left-0 h-full p-6 flex flex-col justify-between">
    <div>
      <!-- Profile Image -->
      <div class="text-center mb-8">
        <img src="/profile.jpeg" alt="Akshyat Ankur Patel" class="w-24 h-24 rounded-full mx-auto object-cover border-2 border-gray-700" style="object-position: 50% 20%;">
        <h2 class="text-xl font-bold mt-3">Akshyat Ankur Patel</h2>
        <p class="text-sm text-gray-400">AI Engineer & Data Scientist</p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3 text-gray-300 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-5v-7H7v7H5a2 2 0 0 1-2-2z"/>
          </svg>
          <span>Home</span>
        </a>
        <a href="/cv" class="flex items-center gap-3 text-gray-300 hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>CV</span>
        </a>
      </nav>

      <!-- Connect Section: Social Links + Phone Numbers -->
      <div class="mt-8 border-t border-gray-800 pt-4">
        <h3 class="text-sm uppercase tracking-wider text-gray-500 mb-3">Connect</h3>

        <!-- Social Icons (proper SVG) -->
        <div class="flex flex-col gap-2">
          {SOCIALS.map((social) => {
            let icon;
            if (social.name === "GitHub") {
              icon = <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>;
            } else if (social.name === "LinkedIn") {
              icon = <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>;
            } else if (social.name === "Instagram") {
              icon = <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>;
            } else {
              icon = <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>;
            }
            return (
              <a key={social.name} href={social.href} target="_blank" rel="noopener noreferrer" class="social-link text-gray-400 hover:text-white transition">
                {icon}
                <span>{social.name}</span>
              </a>
            );
          })}
        </div>

        <!-- Phone Numbers -->
        <div class="mt-4 text-sm">
          <div class="phone-item">📞 UAE: +971 507928403</div>
          <div class="phone-item">📞 India: +91 8598031611</div>
        </div>
      </div>
    </div>
    <div class="text-center text-xs text-gray-600 pt-4">
      © {new Date().getFullYear()} Akshyat Patel
    </div>
  </aside>

  <main class="ml-64 flex-1 p-8">
    <slot />
  </main>
</body>
</html>