---
export interface Props {
  title: string;
  description: string;
  github?: string;
  demo?: string;
}
const { title, description, github, demo } = Astro.props;
---

<div class="card bg-black border border-gray-800 rounded-lg p-5 shadow-sm hover:shadow-md transition">
  <h3 class="text-xl font-bold text-white">{title}</h3>
  <p class="text-gray-400 mt-2">{description}</p>
  <div class="flex gap-3 mt-4">
    {github && github !== "#" && (
      <a href={github} target="_blank" class="btn-github text-sm px-4 py-1.5 rounded">GitHub</a>
    )}
    {demo && demo !== "#" && (
      <a href={demo} target="_blank" class="btn-demo text-sm px-4 py-1.5 rounded font-medium">Live Demo</a>
    )}
  </div>
</div>