---
import { SOCIALS } from "../config";
---

<div class="footer-socials flex gap-4 justify-center mt-4">
  {SOCIALS.map((social) => (
    <a
      href={social.href}
      target="_blank"
      rel="noopener noreferrer"
      class="text-base-content/60 hover:text-primary transition"
      aria-label={social.name}
    >
      <span class="sr-only">{social.name}</span>
      <!-- You can use a simple text fallback or icons. If you have icon components, use them. -->
      <span>{social.name}</span>
    </a>
  ))}
</div>