---
import { SOCIALS } from "../config";
import SideBarMenu from "./SideBarMenu.astro";
import SideBarFooter from "./SideBarFooter.astro";
---

<div class="sidebar">
  <div class="sidebar-inner">
    <!-- Profile Picture -->
    <div class="author-profile text-center">
      <img 
        src="/profile.jpeg" 
        alt="Akshyat Ankur Patel" 
        class="rounded-full w-32 h-32 mx-auto object-cover"
      />
      <h2 class="text-xl font-bold mt-4">Akshyat Ankur Patel</h2>
      <p class="text-sm opacity-75">AI Engineer & Data Scientist</p>
    </div>

    <!-- Navigation Menu (only essential links) -->
    <SideBarMenu />

    <!-- Social Links -->
    <SideBarFooter />
  </div>
</div>