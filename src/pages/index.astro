---
import Layout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
---

<Layout>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold">Akshyat Ankur Patel</h1>
    <p class="text-xl text-gray-400 mt-2">Data Scientist & AI Engineer</p>

    <div class="mt-6 space-y-4 text-gray-300">
      <p>
        Data Scientist & AI Engineer with 2+ years of backend development experience at RedBus (GO-MMT Group), specialising in machine learning, predictive modeling, and high‑scale system optimisation. Proven ability to build production AI systems (R² > 0.96 for industrial energy simulation) and communicate technical value to non‑technical stakeholders.
      </p>
      <p>
        Proficient in Python, Erlang, SQL, LLMs, and cloud deployment. Currently pursuing an MSc in Data Science and AI at Middlesex University Dubai. Passionate about building fault‑tolerant, data‑driven solutions that drive business growth.
      </p>
    </div>

    <h2 class="text-2xl font-bold mt-12 mb-4">Featured Projects</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <Card
        title="UAE Real Estate AI Analyzer"
        description="CatBoost price predictor (R²=0.73, RMSE=2.46M AED) with LLM explanation via Groq Llama 3.3"
        github="https://github.com/akshyat21/UAE-RealEstate-AI"
        demo="https://uae-realestate-ai-kjmsf4tshdkmtvlnzkgqx7.streamlit.app/"
      />
      <Card
        title="Customer Churn Prediction"
        description="Logistic regression (AUC=0.84) with AI-powered retention advice"
        github="https://github.com/akshyat21/AI-Churn-Prediction"
        demo="https://ai-churn-prediction-hpudyompmu5v7jnxk4epso.streamlit.app/"
      />
      <Card
        title="Medical RAG Prototype"
        description="Local RAG system using sentence‑transformers + Groq Llama 3.3. Retrieval on‑premise, swappable with MedGemma + NVIDIA GPU."
        github="https://github.com/akshyat21/medical-rag-prototype"
        demo="#"
      />
      <Card
        title="AI‑Powered Energy Simulator (Internship)"
        description="Ridge regression (R²>0.96) for Dalma Mall – used internally by engineering team"
        github="#"
        demo="#"
      />
      <Card
        title="Multilingual AI Voice Agent"
        description="Speech‑to‑speech AI assistant with 5 languages – Whisper transcription + Llama 3.3 + gTTS"
        github="https://github.com/akshyat21/AI-Voice-Agent-Model"
        demo="https://ai-voice-agent-model-ncpmffbwma268xk6qr5gtb.streamlit.app/"
      />
    </div>
  </div>
</Layout>